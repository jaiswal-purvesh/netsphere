# Copy to .env for local development. Never commit a real .env.
# docker-compose overrides DATABASE_URL/REDIS_URL to point at its own
# postgres/redis services regardless of what's set here — these values
# matter when running the backend directly on your host instead.

APP_NAME=NetSphere
ENVIRONMENT=local
DEBUG=true

DATABASE_URL=postgresql+psycopg://netsphere:netsphere@localhost:5432/netsphere
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=dev-only-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60

CORS_ORIGINS=["http://localhost:3000"]

SEED_ADMIN_EMAIL=admin@netsphere.local
SEED_ADMIN_PASSWORD=ChangeMe123!
