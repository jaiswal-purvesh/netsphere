# Reference only. deploy/install-rhel.sh generates deploy/.env.prod with
# random secrets; edit that file, not this one.
POSTGRES_PASSWORD=__generated__
JWT_SECRET=__generated_64_hex__
INTEGRATIONS_ENCRYPTION_KEY=__generated_64_hex__   # never change after first start
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=__generated__
SEED_DEMO_DATA=false          # true = load demo org + mock discovery
CORS_ORIGINS=["http://netsphere.example.com"]
HTTP_PORT=80
HTTPS_PORT=443
NGINX_CONF=http.conf          # https.conf after placing certs in deploy/certs/
NETSPHERE_VERSION=latest
